---
layout: default
---
<div class="post academic-home">
  <header class="home-hero">
    <div class="home-hero__copy">
      <h1>{{ site.title }}</h1>
      <p class="home-hero__role">{{ page.role }}</p>
      <p class="home-hero__affiliation"><a href="https://gamma.umd.edu/">GAMMA Lab</a> · University of Maryland</p>
      <p class="home-hero__summary">{{ page.summary }}</p>
      <div class="home-hero__actions">
        <a class="text-link" href="{{ '/publications/' | relative_url }}">Publications <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="{{ '/assets/pdf/owen_hoffman_CV.pdf' | relative_url }}">
          Curriculum vitae <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="home-hero__links" aria-label="Professional profiles">
        <a href="mailto:owenhoff01@gmail.com"><i class="fa-solid fa-envelope" aria-hidden="true"></i> Email</a>
        <a href="https://scholar.google.com/citations?user=CSfxU7EAAAAJ"><i class="ai ai-google-scholar" aria-hidden="true"></i> Scholar</a>
        {% comment %}<a href="https://github.com/owen-hoffman40"><i class="fa-brands fa-github" aria-hidden="true"></i> GitHub</a>{% endcomment %}
        <a href="https://www.linkedin.com/in/owenhoffman40/"><i class="fa-brands fa-linkedin" aria-hidden="true"></i> LinkedIn</a>
      </div>
    </div>
    {% if page.profile and page.profile.image %}
      <div class="home-hero__portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="(min-width: 768px) 340px, 70vw" alt="Portrait of Owen M. Hoffman" cache_bust=true %}
        <p class="home-hero__location">
          College Park, Maryland
        </p>
      </div>
    {% endif %}
  </header>

  <article>
    <div>{{ content }}</div>

    {% if page.selected_papers %}
      <section class="home-section selected-work">
        <div class="section-heading">
          <h2>Selected publication</h2>
          <a class="text-link" href="{{ '/publications/' | relative_url }}">All publications <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}
  </article>
</div>
